# Roughly bar shaped symbols (ascending + descending in the middle)
@bars = [backslash bar bracedouble braceleft braceright bracketdouble bracketleft bracketright brokenbar dagger daggerdbl florin parendouble parenleft parenright slash];

# Any punctuation
@punctuation = [colon colon.proportional comma comma.proportional ellipsis exclam exclamdown period period.proportional question questiondown semicolon semicolon.proportional];

