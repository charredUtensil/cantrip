@lowerNotTall = [a aacute abreve acircumflex adieresis ae ae.wide agrave amacron aogonek aring atilde c cacute ccaron ccedilla ccircumflex cdotaccent dcaron dotlessi e e.cursive eacute ebreve ecaron ecircumflex edieresis edotaccent egrave emacron eng eogonek eth g g.cursive gbreve gcedilla gcircumflex gdotaccent germandbls i i.midthin i.sprawl.w i.thin iacute ibreve icircumflex idieresis igrave ij imacron iogonek itilde j j.old1 j.sprawl.s j.thin j.thin.sprawl.sw jcircumflex kgreenlandic m m.midwide m.wide n nacute napostrophe ncaron ncedilla ntilde o oacute obreve ocircumflex odieresis oe ograve ohungarumlaut omacron oslash otilde p q q.sprawl.se r r.midthin racute rcaron rcedilla s s.cursive s.cursive.alt s.cursive.sprawl.w sacute scaron scedilla scircumflex u uacute ubreve ucircumflex udieresis ugrave uhungarumlaut umacron uogonek uring utilde v w w.midwide w.wide wcircumflex x y y.flourish.sw yacute ycircumflex ydieresis z z.sprawl.s z.sprawl.se zacute zcaron zdotaccent];
@lowerNotDescending = [a aacute abreve acircumflex adieresis ae ae.wide agrave amacron aring atilde b c cacute ccaron ccircumflex cdotaccent d dcaron dcroat dotlessi e e.cursive eacute ebreve ecaron ecircumflex edieresis edotaccent egrave emacron eth germandbls h hbar hcircumflex i i.midthin i.sprawl.w i.thin iacute ibreve icircumflex idieresis igrave imacron itilde kgreenlandic l l.midthin l.sprawl.w l.thin lacute lcaron ldot lslash m m.midwide m.wide n nacute napostrophe ncaron ntilde o oacute obreve ocircumflex odieresis oe ograve ohungarumlaut omacron oslash otilde r r.midthin racute rcaron s s.cursive s.cursive.alt s.cursive.sprawl.w sacute scaron scircumflex t t.cursive t.cursive.before.i.thin t.cursive.before.t t.cursive.sprawl.e t.midthin tbar tcaron u uacute ubreve ucircumflex udieresis ugrave uhungarumlaut umacron uring utilde v w w.midwide w.wide wcircumflex x z zacute zcaron zdotaccent];
@lowerLeftTall = [@b @h @k l l.midthin l.sprawl.w lacute lcaron lcedilla ldot lslash t t.midthin tbar tcaron tcedilla germandbls thorn];
@lowerRightTall = [@d @f];

@flourishCompatSW = [
  a aacute abreve acircumflex adieresis ae ae.wide agrave amacron aring atilde b c cacute ccaron ccircumflex cdotaccent d dcaron dcroat dotlessi e eacute ebreve ecaron ecircumflex edieresis edotaccent egrave emacron eth germandbls h hbar hcircumflex i i.sprawl.w iacute ibreve icircumflex idieresis igrave imacron itilde kgreenlandic l l.sprawl.w lacute lcaron ldot lslash m m.midwide m.wide n nacute napostrophe ncaron ntilde o oacute obreve ocircumflex odieresis oe ograve ohungarumlaut omacron oslash otilde r racute rcaron s sacute scaron scircumflex t tbar tcaron u uacute ubreve ucircumflex udieresis ugrave uhungarumlaut umacron uring utilde v w w.midwide w.wide wcircumflex x z zacute zcaron zdotaccent
];

# Misc incompatibilities
@blocksHex = [
  @G @H @I @J @K @L @M @N @O @P @Q @R @S @T @U @V @W @X @Y
  @g @h @i @j @k @l @m @n @o @p @q @r @s @t @u @v @w @x @y
  Aacute Abreve Acircumflex Adieresis Agrave Amacron Aring Atilde Cacute Ccaron Ccircumflex Cdotaccent Dcaron Eacute Ebreve Ecaron Ecircumflex Edieresis Edotaccent Egrave Emacron Gbreve Gcircumflex Gdotaccent Hcircumflex Iacute Ibreve Icircumflex Idieresis Idotaccent Igrave Imacron Itilde Jcircumflex Lacute Nacute Ncaron Ntilde Oacute Obreve Ocircumflex Odieresis Ograve Ohungarumlaut Omacron Otilde Racute Rcaron Sacute Scaron Scircumflex Tcaron Uacute Ubreve Ucircumflex Udieresis Ugrave Uhungarumlaut Umacron Uring Utilde Wcircumflex Yacute Ycircumflex Ydieresis Zacute Zcaron Zdotaccent aacute abreve acircumflex adieresis agrave amacron aring atilde cacute ccaron ccircumflex cdotaccent eacute ebreve ecaron ecircumflex edieresis edotaccent egrave emacron gbreve gcedilla gcircumflex gdotaccent hcircumflex i i.midthin i.sprawl.w i.thin iacute ibreve icircumflex idieresis igrave ij imacron iogonek itilde j j.old1 j.sprawl.s j.thin j.thin.sprawl.sw jcircumflex lacute nacute napostrophe ncaron ntilde oacute obreve ocircumflex odieresis ograve ohungarumlaut omacron otilde racute rcaron sacute scaron scircumflex uacute ubreve ucircumflex udieresis ugrave uhungarumlaut umacron uring utilde wcircumflex yacute ycircumflex ydieresis zacute zcaron zdotaccent
  Aogonek Ccedilla Eogonek Gcedilla Iogonek Kcedilla Lcedilla Ncedilla Rcedilla Scedilla Tcedilla Uogonek aogonek ccedilla eogonek iogonek kcedilla lcedilla ncedilla rcedilla scedilla tcedilla uogonek
  Dcroat Eth Hbar Lcaron Ldot Lslash Oslash Tbar dcaron dcroat hbar kgreenlandic lcaron ldot lslash oslash tbar tcaron
  AE AE.wide Eng IJ OE Thorn ae ae.wide dotlessi eng eth germandbls ij longs oe
];
@blocksSprawlNW = [
  @digitsLining
  A A.proportional A.short A.sprawl.s A.sprawl.s.wide A.wide AE AE.wide Aacute Abreve Acircumflex Adieresis Agrave Amacron Aogonek Aring Atilde B B.sprawl.nw C C.short C.sprawl.e C.sprawl.e.proportional C.sprawl.s Cacute Ccaron Ccedilla Ccircumflex Cdotaccent D D.proportional D.sprawl.nw Dcaron Dcroat E E.short Eacute Ebreve Ecaron Ecircumflex Edieresis Edotaccent Egrave Emacron Eng Eogonek Eth F F.sprawl.e G G.proportional G.short G.wide Gbreve Gcedilla Gcircumflex Gdotaccent H H.proportional Hbar Hcircumflex I I.midthin I.short IJ Iacute Ibreve Icircumflex Idieresis Idotaccent Igrave Imacron Iogonek Itilde J J.sprawl.s J.thin.sprawl.sw Jcircumflex K K.sprawl.se Kcedilla M M.wide N N.proportional N.short N.sprawl.s Nacute Ncaron Ncedilla Ntilde O O.short OE Oacute Obreve Ocircumflex Odieresis Ograve Ohungarumlaut Omacron Oslash Otilde P P.sprawl.nw Q Q.sprawl.se R R.short R.sprawl.nw R.sprawl.nwse R.sprawl.se Racute Rcaron Rcedilla S S.cursive S.cursive.wide S.short Sacute Scaron Scedilla Scircumflex T Tbar Tcaron Tcedilla Thorn U U.short Uacute Ubreve Ucircumflex Udieresis Ugrave Uhungarumlaut Umacron Uogonek Uring Utilde V V.proportional V.sprawl.nwne V.sprawl.w W W.wide W.wide.alt Wcircumflex X X.sprawl.s Y Y.short Y.sprawl.nwne Y.sprawl.w Yacute Ycircumflex Ydieresis Z Z.short Z.sprawl.s Z.sprawl.se Zacute Zcaron Zdotaccent
  @lowerRightTall
];
@blocksSprawlNWSwash = [
  @blocksSprawlNW
  quotedbl quotedblleft quotedblright quoteleft quoteright quotesingle quotesingle.thin
];
@blocksSprawlNE = [
  @digitsLining
  @upper
  @lowerLeftTall
];
@blocksSprawlSW = [
  @K @R Z.sprawl.s Z.sprawl.se Eng IJ
  aogonek eogonek @g @j k.sprawl.se @q @tCursive @y z.sprawl.s z.sprawl.se eng ij
];
@blocksSprawlSE.lower = [
  @A @L @M @W @X @Z IJ
  @f @g @j @p @y ij thorn
  @bars @commaLike slash
];
@blocksSprawlSE.upper = [
  @blocksSprawlSE.lower
  @B @C @D @E @F @I @H @J @K @N @P @R AE Eng
];
@blocksSprawlE.tCursive = [
  @upper @lower @digits @punctuation @lining
];

# Digit groups (order matters)
@normalDigits = [
  zero one two three four five six seven eight nine
];
@hexDigits = [
  zero.hex one.hex two.hex three.hex four.hex
  five.hex six.hex seven.hex eight.hex nine.hex
  a.hex b.hex c.hex d.hex e.hex f.hex
  A.hex B.hex C.hex D.hex E.hex F.hex
];
@hexable = [@normalDigits a b c d e f A B C D E F underscore];
@hexed = [@hexDigits underscore.hex];

@quotesingle = [quotesingle quotesingle.thin];

###############################################################################
# Lining Numerals                                                             #
###############################################################################

lookup lining {
  sub zero by zero.lining;
sub one by one.lining;
sub two by two.lining;
sub three by three.lining;
sub four by four.lining;
sub five by five.lining;
sub six by six.lining;
sub seven by seven.lining;
sub eight by eight.lining;
sub nine by nine.lining;
sub dollar by dollar.lining;
sub Euro by Euro.lining;
sub sterling by sterling.lining;
sub yen by yen.lining;
} lining;

###############################################################################
# Replace hexadecimal literals with special glyphs                            #
###############################################################################

lookup toHex {
    sub [ @hexable x X ] by [ @hexed x.hex X.hex ];
} toHex;

lookup hexify {
    # Any sequence of at least 2 hex digits prefixed with 0x, 0X, or #
    sub zero x' lookup toHex;
    sub zero X' lookup toHex;
    @prefix = [ x.hex X.hex numbersign ];

    # Ignore things that look too much like words.
    ignore sub @prefix @hexable'@hexable @blocksHex, @prefix @hexable'@hexable @hexable @blocksHex, @prefix @hexable'@hexable @hexable @hexable @blocksHex, @prefix @hexable'@hexable @hexable @hexable @hexable @blocksHex, @prefix @hexable'@hexable @hexable @hexable @hexable @hexable @blocksHex, @prefix @hexable'@hexable @hexable @hexable @hexable @hexable @hexable @blocksHex, @prefix @hexable'@hexable @hexable @hexable @hexable @hexable @hexable @hexable @blocksHex;

    # Prefix followed by at least 2 hex digits
    sub @prefix @hexable' lookup toHex @hexable;

    # Any hexable digit following a hexed digit
    sub @hexed @hexable' lookup toHex;

    # Any sequence of at least 16 hexable digits
    sub @hexable' lookup toHex@hexable @hexable @hexable @hexable @hexable @hexable @hexable @hexable @hexable @hexable @hexable @hexable @hexable @hexable @hexable;
} hexify;

lookup afterHexify {
  sub [x.hex X.hex]' by [x X];
} afterHexify;

###############################################################################
# Cursive alternates                                                          #
###############################################################################

lookup toCursive {
  sub e by e.cursive;
  sub f by f.cursive;
  sub g by g.cursive;
  sub S by S.cursive;
  sub s by s.cursive;
  sub t by t.cursive;
} toCursive;

lookup cursiveAlts {
  # e
  sub  [g.cursive @tCursive]  e' lookup toCursive;
  sub  b s.cursive            e' lookup toCursive;
  sub  o s.cursive            e' lookup toCursive;

  # f
  sub @fCursive @f' lookup toCursive;
  sub [@lowerNotTall @lowerLeftTall] [i l] @f' lookup toCursive;

  # g
  ignore sub g g';
  sub g' lookup toCursive                     [e r s];
  sub g' lookup toCursive g' lookup toCursive [e r s];
  sub [g.cursive @sCursive @tCursive] g' lookup toCursive;

  # S and s
  ignore sub s' s, s s', S S';
  sub [@upper @lower] s' lookup toCursive @lower;
  sub g.cursive s' lookup toCursive;
  sub [@upper @lower] @quotesingle s' lookup toCursive;
  sub S' lookup toCursive @lower;

  # t
  @notBeforet  = [@d f f.flourish.sw f.sprawl.sw @l];
  @beforet     = [@c @fCursive @p @tCursive @sCursive @SCursive];
  @notAftert   = [@h @k @l @upper];
  @aftert      = [@r @s @w];

  ignore sub     @notBeforet  t'                                            ;
  ignore sub                  t'                    @notAftert              ;
  sub            @beforet     t' lookup toCursive                           ;
  sub                         t' lookup toCursive                  @aftert  ;
  sub                         t' lookup toCursive     @quotesingle @aftert  ;
  sub                         t' lookup toCursive   t              @aftert  ;
  sub                         t' lookup toCursive   t @quotesingle @aftert  ;         ;
} cursiveAlts;

###############################################################################
# Sprawling glyphs (Takes up extra space but doesn't change width)            #
###############################################################################

lookup toSprawl {
  sub A                    by  A.sprawl.s           ;
  sub B                    by  B.sprawl.nw          ;
  sub C                    by  C.sprawl.s           ;
  sub D                    by  D.sprawl.nw          ;
  sub f                    by  f.sprawl.sw          ;
  sub i                    by  i.sprawl.w           ;
  sub J                    by  J.sprawl.s           ;
  sub j                    by  j.sprawl.s           ;
  sub K                    by  K.sprawl.se          ;
  sub k                    by  k.sprawl.se          ;
  sub L                    by  L.sprawl.s           ;
  sub l                    by  l.sprawl.w           ;
  sub N                    by  N.sprawl.s           ;
  sub P                    by  P.sprawl.nw          ;
  sub Q                    by  Q.sprawl.se          ;
  sub q                    by  q.sprawl.se          ;
  sub R                    by  R.sprawl.se          ;
  sub t.cursive            by  t.cursive.sprawl.e   ;
  sub V                    by  V.sprawl.nwne        ;
  sub X                    by  X.sprawl.s           ;
  sub Y                    by  Y.sprawl.nwne        ;
  sub Z                    by  Z.sprawl.se          ;
  sub z                    by  z.sprawl.se          ;
} toSprawl;

lookup toSprawlAlt {
  sub C                    by  C.sprawl.e           ;
  sub F                    by  F.sprawl.e           ;
  sub R                    by  R.sprawl.nw          ;
  sub R.sprawl.se          by  R.sprawl.nwse        ;
  sub s.cursive            by  s.cursive.sprawl.w   ;
  sub V                    by  V.sprawl.w           ;
  sub Y                    by  Y.sprawl.w           ;
  sub Z                    by  Z.sprawl.s           ;
  sub z                    by  z.sprawl.s           ;
} toSprawlAlt;

@blocksFirstCapSprawl = [@upper @lining];
lookup sprawl1 {
  ignore sub @blocksFirstCapSprawl  [A C J L N X Z]'                          ;
  ignore sub @lower                 [J j z]'                                  ;
  ignore sub @blocksSprawlSW        f'                                        ;
  ignore sub @blocksSprawlNWSwash   [B D P]'                                  ;
  ignore sub @blocksSprawlNW        [V Y]'                                    ;
  ignore sub                        [V Y]'           @blocksSprawlNE          ;

  @CCompat = [@xHeight @d @q];
  @FCompat = [@A @CCompat @lowerNotTall];
  sub C' lookup toSprawlAlt @CCompat;
  sub F' lookup toSprawlAlt @FCompat;
  sub Z' lookup toSprawlAlt @blocksSprawlSE.upper;
  sub z' lookup toSprawlAlt @blocksSprawlSE.lower;

  sub [@F @P @T @r @v @quotesingle] s.cursive' lookup toSprawlAlt;

  ignore sub                   [K Q R]'              @blocksSprawlSE.upper    ;
  ignore sub                   [k q]'                @blocksSprawlSE.lower    ;
  ignore sub                   t.cursive'            @blocksSprawlE.tCursive  ;

  sub [A B C D f J j K k L N P Q q R t.cursive V X Y Z z]' lookup toSprawl;
} sprawl1;

lookup sprawl2 {
  ignore sub @blocksSprawlNWSwash @R';
  sub [R R.sprawl.se]' lookup toSprawlAlt;
  sub [L L.proportional Lacute Lcaron Lcedilla Ldot Lslash] [V Y]' lookup toSprawlAlt;
} sprawl2;

###############################################################################
# Thin-Wide Pairings                                                          #
###############################################################################

lookup tw1 {
  # Use ligatures for these double-letters so they are widened or thinned
  # together. Otherwise, the end result looks wrong. These glyphs are all
  # placeholders only used within this section.

  sub i i  by  ii;
  sub l l  by  ll;
  sub m m  by  mm;
  sub r r  by  rr;
  sub t t  by  tt;
  sub w w  by  ww;
} tw1;

@wideUpperA = [ A      A.sprawl.s      AE      G      M      S.cursive      W      ];
@wideUpperB = [ A.wide A.sprawl.s.wide AE.wide G.wide M.wide S.cursive.wide W.wide ];
@wideLowerA = [ ae      m      mm      w      ww      ];
@wideLowerB = [ ae.wide m.wide mm.wide w.wide ww.wide ];
@narrowA = [ i      ii      j      j.sprawl.s l      ll      rr      tt      ];
@narrowB = [ i.thin ii.thin j.thin j.thin     l.thin ll.thin rr.thin tt.thin ];

lookup widen {
  sub [@wideUpperA @wideLowerA] by [@wideUpperB @wideLowerB];
} widen;

lookup narrow {
  sub [
    @narrowA
    L L.sprawl.s
    quotesingle
    i.midthin l.midthin
  ] by [
    @narrowB
    L.thin.sprawl.se L.thin.sprawl.se
    quotesingle.thin
    i.thin l.thin
  ];
} narrow;

lookup narrowJ {
  sub [J J.sprawl.s j] by [J.thin.sprawl.sw J.thin.sprawl.sw j.thin.sprawl.sw];
} narrowJ;

lookup tw2 {
  # Find pairs of letters to thin and wide

  ignore sub @upper @wideUpperA';

  @Lt = [L L.sprawl.s];
  @jt = [J J.sprawl.s j];

  # Sub immediate pairs.
  # Wj
  sub
    [@wideUpperA @wideLowerA]' lookup widen
    @jt' lookup narrowJ;
  # Wi
  sub
    [@wideUpperA @wideLowerA]' lookup widen
    @narrowA' lookup narrow;
  # W'x
  sub
    [@wideUpperA @wideLowerA]' lookup widen
    quotesingle' lookup narrow
    [@upper @lower];
  # xjw
  sub
    @lowerNotDescending
    @jt' lookup narrowJ
    @wideLowerA' lookup widen;
  # iw / Lw
  sub
    [@narrowA @Lt]' lookup narrow
    @wideLowerA' lookup widen;
  # X'w
  sub
    [@upper @lower]
    quotesingle' lookup narrow
    @wideLowerA' lookup widen;
} tw2;
  
# With space in the middle
@skipTw2 = [a aacute abreve acircumflex adieresis ae agrave amacron aogonek aring atilde b c cacute ccaron ccedilla ccircumflex cdotaccent d dcaron dcroat dotlessi e e.cursive eacute ebreve ecaron ecircumflex edieresis edotaccent egrave emacron eng eogonek eth f f.cursive f.flourish.sw f.sprawl.sw g g.cursive gbreve gcedilla gcircumflex gdotaccent germandbls h hbar hcircumflex i i.sprawl.w iacute ibreve icircumflex idieresis igrave ij imacron iogonek itilde j j.old1 j.sprawl.s jcircumflex k k.sprawl.se kcedilla kgreenlandic l l.sprawl.w lacute lcaron lcedilla ldot longs lslash m n nacute napostrophe ncaron ncedilla ntilde o oacute obreve ocircumflex odieresis oe ograve ohungarumlaut omacron oslash otilde p q q.sprawl.se r racute rcaron rcedilla s s.cursive s.cursive.alt s.cursive.sprawl.w sacute scaron scedilla scircumflex t t.cursive t.cursive.before.t t.cursive.sprawl.e t.cursive.sprawl.se tbar tcaron tcedilla thorn u uacute ubreve ucircumflex udieresis ugrave uhungarumlaut umacron uogonek uring utilde v w wcircumflex x y y.flourish.sw yacute ycircumflex ydieresis z z.sprawl.s z.sprawl.se zacute zcaron zdotaccent];
@skipTw2BeforeJ = [a aacute abreve acircumflex adieresis ae agrave amacron aring atilde b c cacute ccaron ccircumflex cdotaccent d dcaron dcroat dotlessi e e.cursive eacute ebreve ecaron ecircumflex edieresis edotaccent egrave emacron eth germandbls h hbar hcircumflex i i.sprawl.w iacute ibreve icircumflex idieresis igrave imacron itilde kgreenlandic l l.sprawl.w lacute lcaron ldot lslash m n nacute napostrophe ncaron ntilde o oacute obreve ocircumflex odieresis oe ograve ohungarumlaut omacron oslash otilde r racute rcaron s s.cursive s.cursive.alt s.cursive.sprawl.w sacute scaron scircumflex t t.cursive t.cursive.before.t t.cursive.sprawl.e tbar tcaron u uacute ubreve ucircumflex udieresis ugrave uhungarumlaut umacron uring utilde v w wcircumflex x z zacute zcaron zdotaccent @p thorn];
@skipTw2AfterL = [a aacute abreve acircumflex adieresis ae agrave amacron aring atilde b c cacute ccaron ccircumflex cdotaccent d dcaron dcroat dotlessi e e.cursive eacute ebreve ecaron ecircumflex edieresis edotaccent egrave emacron eth germandbls h hbar hcircumflex i i.sprawl.w iacute ibreve icircumflex idieresis igrave imacron itilde kgreenlandic l l.sprawl.w lacute lcaron ldot lslash m n nacute napostrophe ncaron ntilde o oacute obreve ocircumflex odieresis oe ograve ohungarumlaut omacron oslash otilde r racute rcaron s s.cursive s.cursive.alt s.cursive.sprawl.w sacute scaron scircumflex t t.cursive t.cursive.before.t t.cursive.sprawl.e tbar tcaron u uacute ubreve ucircumflex udieresis ugrave uhungarumlaut umacron uring utilde v w wcircumflex x z zacute zcaron zdotaccent @q];

lookup tw2_skip1 {
  # Wxj
  sub
    [@wideUpperA @wideLowerA]' lookup widen
     @skipTw2BeforeJ
    @jt' lookup narrowJ;
  # Wxi
  sub
    [@wideUpperA @wideLowerA]' lookup widen
    @skipTw2 
    @narrowA' lookup narrow;
  # Wx'x
  sub
    [@wideUpperA @wideLowerA]' lookup widen
    @skipTw2 
    quotesingle' lookup narrow
    [@upper @lower];
  # xjxw
  sub
    [@lowerNotDescending @p thorn]
    @jt' lookup narrowJ
    @skipTw2 
    @wideLowerA' lookup widen;
  # ixw
  sub
    @narrowA' lookup narrow
    @skipTw2 
    @wideLowerA' lookup widen;
  # x'xw
  sub
    [@upper @lower]
    quotesingle' lookup narrow
    @skipTw2 
    @wideLowerA' lookup widen;
  # Lxw
  sub
    @Lt' lookup narrow
    @skipTw2AfterL 
    @wideLowerA' lookup widen;
} tw2_skip1;

lookup tw2_skip2 {
  # Wxxj
  sub
    [@wideUpperA @wideLowerA]' lookup widen
    @skipTw2  @skipTw2BeforeJ
    @jt' lookup narrowJ;
  # Wxi
  sub
    [@wideUpperA @wideLowerA]' lookup widen
    @skipTw2 @skipTw2 
    @narrowA' lookup narrow;
  # Wxx'x
  sub
    [@wideUpperA @wideLowerA]' lookup widen
    @skipTw2 @skipTw2 
    quotesingle' lookup narrow
    [@upper @lower];
  # xjxxw
  sub
    [@lowerNotDescending @p thorn]
    @jt' lookup narrowJ
    @skipTw2 @skipTw2 
    @wideLowerA' lookup widen;
  # ixxw
  sub
    @narrowA' lookup narrow
    @skipTw2 @skipTw2 
    @wideLowerA' lookup widen;
  # x'xxw
  sub
    [@upper @lower]
    quotesingle' lookup narrow
    @skipTw2 @skipTw2 
    @wideLowerA' lookup widen;
  # Lxxw
  sub
    @Lt' lookup narrow
    @skipTw2AfterL @skipTw2 
    @wideLowerA' lookup widen;
} tw2_skip2;


lookup midden {
  sub [
    i i.thin
    l l.thin
    r
    t
    m m.wide
    w w.wide
  ] by [
    i.midthin i.midthin
    l.midthin l.midthin
    r.midthin
    t.midthin
    m.midwide m.midwide
    w.midwide w.midwide
  ];
} midden;

lookup tw3 {
  # Balance pairs of nearby letters


  # ii
  sub
   [i l r t]' lookup midden
   
   [i.thin l.thin]' lookup midden;
  sub
   [i.thin l.thin]' lookup midden
   
   [i l r t]' lookup midden;
  # ww
  sub
   [m w]' lookup midden
   
   [m.wide w.wide]' lookup midden;
  sub
   [m.wide w.wide]' lookup midden
   
   [m w]' lookup midden;

  # ixi
  sub
   [i l r t]' lookup midden
   @lower 
   [i.thin l.thin]' lookup midden;
  sub
   [i.thin l.thin]' lookup midden
   @lower 
   [i l r t]' lookup midden;
  # wxw
  sub
   [m w]' lookup midden
   @lower 
   [m.wide w.wide]' lookup midden;
  sub
   [m.wide w.wide]' lookup midden
   @lower 
   [m w]' lookup midden;

  # ixxi
  sub
   [i l r t]' lookup midden
   @lower @lower 
   [i.thin l.thin]' lookup midden;
  sub
   [i.thin l.thin]' lookup midden
   @lower @lower 
   [i l r t]' lookup midden;
  # wxxw
  sub
   [m w]' lookup midden
   @lower @lower 
   [m.wide w.wide]' lookup midden;
  sub
   [m.wide w.wide]' lookup midden
   @lower @lower 
   [m w]' lookup midden;

} tw3;

lookup tw4 {
  # Remove double-letter ligatures

  sub ii       by  i         i;
  sub ll       by  l         l;
  sub mm       by  m         m;
  sub rr       by  r         r;
  sub tt       by  t         t;
  sub ww       by  w         w;
  sub ii.thin  by  i.midthin i.midthin;
  sub ll.thin  by  l.midthin l.midthin;
  sub rr.thin  by  r.midthin r.midthin;
  sub tt.thin  by  t.midthin t.midthin;
  sub mm.wide  by  m.midwide m.midwide;
  sub ww.wide  by  w.midwide w.midwide;
} tw4;

lookup proportional1 {
  # Primary proportional glyph subs

  sub A                by  A.proportional;
  sub A.sprawl.s       by  A.proportional;
  sub A.wide           by  A.proportional;
  sub A.sprawl.s.wide  by  A.proportional;
  sub C.sprawl.e       by  C.sprawl.e.proportional;
  sub D                by  D.proportional;
  sub G                by  G.proportional;
  sub H                by  H.proportional;
  sub I                by  I.midthin;
  sub i                by  i.thin;
  sub i.midthin        by  i.thin;
  sub L                by  L.proportional;
  sub l                by  l.thin;
  sub l.midthin        by  l.thin;
  sub M                by  M.wide;
  sub m                by  m.wide;
  sub m.midwide        by  m.wide;
  sub N                by  N.proportional;
  sub r                by  r.midthin;
  sub S.cursive        by  S.cursive.wide;
  sub t                by  t.midthin;
  sub V                by  V.proportional;
  sub V.sprawl.nwne    by  V.proportional;
  sub W                by  W.wide;
  sub w                by  w.wide;

  sub space            by  space.proportional;
  sub emdash           by  emdash.proportional;

  sub quotesingle      by  quotesingle.thin;
  sub period           by  period.proportional;
  sub comma            by  comma.proportional;
  sub semicolon        by  semicolon.proportional;
  sub colon            by  colon.proportional;
} proportional1;

lookup proportional2 {
  # Perform any contextual substitutions

  sub L.sprawl.s' [@lowerNotDescending @q] by L.thin.sprawl.se;
} proportional2;

lookup proportionalPos {
  pos
    [A.proportional L.sprawl.s L.proportional]
    [Y.sprawl.nwne Y.sprawl.w]
    -30;
  pos
    V.proportional
    [@lowerNotTall @lowerRightTall A.proportional]
    -30;
  pos
    [@lowerNotTall @lowerLeftTall]
    V.proportional
    -30;
  pos
    [T quotesingle.thin]
    [@lowerNotTall @lowerRightTall]
    -100;
  pos 
    [@L @lowerNotTall @lowerLeftTall]
    [
      T V.proportional Y Y.short Yacute Ycircumflex Ydieresis
      f f.flourish.sw f.sprawl.sw longs
      quotesingle.thin
    ]
    -100;
} proportionalPos;

###############################################################################
# Final Cleanup & Ligatures                                                   #
###############################################################################

@wantSprawlW.il = [
  L L.sprawl.s i.sprawl.w l.sprawl.w
];

lookup sprawl3 {
  # If we get here with unmodified "i" or "l" glyphs, attempt to balance them
  # visually based on their position in the word.
  # This is an incredibly minor tweak, but helps to hide defects in certain
  # words like "application" and "api"

  ignore sub                                  [i l]'                  j                ;
  sub                        @wantSprawlW.il  [i l]' lookup toSprawl                   ;
  ignore sub                               i  i'                                       ;
  ignore sub                               l  l'                                       ;
  ignore sub                                  i'                      [@lower]         ;
  sub         [@lowerNotTall @lowerLeftTall]  [i l]' lookup toSprawl                   ;
} sprawl3;

lookup flourish {
  sub @flourishCompatSW [f f.sprawl.sw y]' by [f.flourish.sw f.flourish.sw y.flourish.sw];
} flourish;

lookup cursiveJoiners {
  sub  @tCursive' @tCursive        by  t.cursive.before.t;
  sub  @tCursive' [i.thin l.thin]  by  t.cursive.before.i.thin;
} cursiveJoiners;

lookup cursiveLigatures {
  sub  b          s.cursive  by  bs.cursive;

  sub  g.cursive  r          by  gr.cursive;
  sub  g.cursive  s.cursive  by  gs.cursive;

  sub  i          s.cursive  by  is.cursive;
  sub  i.sprawl.w s.cursive  by  is.sprawl.w.cursive;
  sub  i.midthin  s.cursive  by  is.cursive.midthin;
  sub  i.thin     s.cursive  by  is.cursive.thin;

  sub  l          s.cursive  by  ls.cursive;
  sub  l.sprawl.w s.cursive  by  ls.sprawl.w.cursive;
  sub  l.midthin  s.cursive  by  ls.cursive.midthin;
  sub  l.thin     s.cursive  by  ls.cursive.thin;

  sub  o          s.cursive  by  os.cursive;

  sub  t.cursive  r          by  tr.cursive;
  sub  t.cursive  r.midthin  by  tr.cursive.midthin;
  sub  t.cursive  s.cursive  by  ts.cursive;

  sub t.cursive quotesingle.thin s.cursive by tquotesingles.cursive.thin;
} cursiveLigatures;

lookup liga {
  sub T T by TT;
  sub parenleft parenright by parendouble;
  sub bracketleft bracketright by bracketdouble;
  sub braceleft braceright by bracedouble;
} liga;

###############################################################################
# Feature Definitions (order here doesn't actually matter)                    #
###############################################################################

feature calt {
  script DFLT;
    language dflt ;
    lookup sprawl1;
    lookup sprawl2;
    lookup sprawl3;
    lookup tw1;
    lookup tw2;
    lookup tw2_skip1;
    lookup tw2_skip2;
    lookup tw3;
    lookup tw4;
  script latn;
    language dflt ;
    lookup sprawl1;
    lookup sprawl2;
    lookup sprawl3;
    lookup tw1;
    lookup tw2;
    lookup tw2_skip1;
    lookup tw2_skip2;
    lookup tw3;
    lookup tw4;
} calt;

feature liga {
  script DFLT;
    language dflt ;
    lookup liga;
  script latn;
    language dflt ;
    lookup liga;
} liga;

feature lnum {
  script DFLT;
    language dflt ;
    lookup lining;
  script latn;
    language dflt ;
    lookup lining;
} lnum;

feature ss01 {
  script DFLT;
    language dflt ;
    lookup cursiveAlts;
  script latn;
    language dflt ;
    lookup cursiveAlts;
} ss01;

feature ss02 {
  script DFLT;
    language dflt ;
    lookup cursiveJoiners;
    lookup cursiveLigatures;
  script latn;
    language dflt ;
    lookup cursiveJoiners;
    lookup cursiveLigatures;
} ss02;

feature ss03 {
  script DFLT;
    language dflt ;
    lookup flourish;
  script latn;
    language dflt ;
    lookup flourish;
} ss03;

feature ss08 {
  script DFLT;
    language dflt ;
    lookup proportional1;
    lookup proportional2;
    lookup proportionalPos;
  script latn;
    language dflt ;
    lookup proportional1;
    lookup proportional2;
    lookup proportionalPos;
} ss08;

feature ss16 {
  script DFLT;
    language dflt ;
    lookup hexify;
    lookup afterHexify;
  script latn;
    language dflt ;
    lookup hexify;
    lookup afterHexify;
} ss16;
